---
// The eight-layer view of the NVIDIA GPU stack, with the two instrumentation
// boundaries drawn in. A mermaid flowchart cannot carry this: the meaning is in
// the vertical order and in where the dashed cuts fall, and mermaid would lay
// the same nodes out as a graph.
//
// Colours come from Starlight's own tokens where a token exists, so the panel
// and the text follow the reader's colour scheme without a second palette.
// The accent hues come from the --gs-hue-* set in custom.css, which is already
// stated once per scheme.
---

<div class="gpu-stack" role="group" aria-label="NVIDIA GPU stack by layer">
	<div class="rig">
		<div class="bar dimmed">
			<span class="lv">L7</span><span class="tx">Application</span>
			<span class="sub">PyTorch, a CUDA binary</span>
		</div>
		<div class="cal"><b>Replaced</b><span>the fuzzer emits payloads directly</span></div>

		<div class="bar dimmed">
			<span class="lv">L6</span><span class="tx">CUDA runtime</span>
			<span class="sub">libcudart, cuBLAS, NCCL</span>
		</div>
		<div class="cal"></div>

		<div class="bar dimmed">
			<span class="lv">L5</span><span class="tx">CUDA driver API</span>
			<span class="sub">libcuda.so, closed</span>
		</div>
		<div class="cal"></div>

		<div class="cut cyn"><i></i>system call boundary<i></i></div>

		<div class="bar hot">
			<span class="lv">L4</span><span class="tx">Device nodes</span>
			<span class="sub">/dev/nvidiactl, /dev/nvidia-uvm</span>
		</div>
		<div class="cal k"><b>Source</b><span>unprivileged ioctl</span></div>

		<div class="bar tgt">
			<span class="lv">L3</span><span class="tx">Kernel modules</span>
			<span class="sub">nvidia.ko, nvidia-uvm.ko</span>
		</div>
		<div class="cal g"><b>Sink</b><span>kernel memory corruption</span></div>

		<div class="bar tgt">
			<span class="lv">L2</span><span class="tx">Resource Manager, kernel side</span>
			<span class="sub">RPC client to GSP</span>
		</div>
		<div class="cal g"><b>Instrumented</b><span>KASAN and KCOV</span></div>

		<div class="cut red"><i></i>KCOV stops here<i></i></div>

		<div class="bar dead">
			<span class="lv">L1</span><span class="tx">GSP firmware</span>
			<span class="sub">signed RISC-V, most of RM</span>
		</div>
		<div class="cal r"><b>No claim</b><span>a defect here shows only as an Xid</span></div>

		<div class="bar dimmed">
			<span class="lv">L0</span><span class="tx">GPU silicon</span>
			<span class="sub">SMs, GMMU, copy engines</span>
		</div>
		<div class="cal"></div>

		<div class="cut cyn"><i></i>PCIe passthrough, IOMMU<i></i></div>

		<div class="bar dimmed">
			<span class="lv">HV</span><span class="tx">Hypervisor and host</span>
			<span class="sub">provider boundary</span>
		</div>
		<div class="cal"><b>Fenced</b><span>a panic reboots this guest</span></div>
	</div>

	<div class="legend">
		<span class="lg"><span class="sw k"></span>attack surface</span>
		<span class="lg"><span class="sw g"></span>instrumented target</span>
		<span class="lg"><span class="sw r"></span>no instrumentation</span>
		<span class="lg"><span class="sw n"></span>out of scope</span>
	</div>
</div>

<style>
	.gpu-stack {
		--k: var(--gs-hue-amber);
		--live: var(--gs-hue-green);
		--blind: var(--gs-hue-red);
		--cy: var(--gs-hue-cyan);
		--panel: var(--sl-color-gray-6);
		--edge: var(--sl-color-gray-5);
		margin-block: 1.5rem;
	}

	.rig {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(9rem, 13rem);
		gap: 0 0.9rem;
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		position: relative;
		overflow: hidden;
		margin-bottom: 0.35rem;
		padding: 0.5rem 0.9rem;
		border: 1px solid var(--edge);
		border-radius: 0.5rem;
		background: var(--panel);
	}
	.bar::before {
		content: '';
		position: absolute;
		inset: 0 auto 0 0;
		width: 3px;
		background: var(--c, transparent);
	}
	.bar .lv {
		flex: none;
		width: 1.7rem;
		font-family: var(--__sl-font-mono);
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--sl-color-gray-3);
	}
	.bar .tx {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--sl-color-white);
		line-height: 1.3;
	}
	.bar .sub {
		margin-left: auto;
		text-align: right;
		font-family: var(--__sl-font-mono);
		font-size: 0.7rem;
		color: var(--sl-color-gray-3);
		line-height: 1.4;
	}
	.bar.dimmed { opacity: 0.62; }
	.bar.hot  { --c: var(--k);     border-color: color-mix(in srgb, var(--k) 50%, var(--edge)); }
	.bar.tgt  { --c: var(--live);  border-color: color-mix(in srgb, var(--live) 50%, var(--edge)); }
	.bar.dead { --c: var(--blind); border-color: color-mix(in srgb, var(--blind) 50%, var(--edge)); }

	.cal {
		display: flex;
		flex-direction: column;
		justify-content: center;
		margin-bottom: 0.35rem;
		padding-left: 0.1rem;
		font-size: 0.78rem;
		line-height: 1.35;
	}
	.cal b {
		font-family: var(--__sl-font-mono);
		font-size: 0.63rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}
	.cal span { color: var(--sl-color-gray-2); }
	.cal.k b { color: var(--k); }
	.cal.g b { color: var(--live); }
	.cal.r b { color: var(--blind); }

	.cut {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin: 0.15rem 0 0.5rem;
		font-family: var(--__sl-font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.cut i {
		flex: 1;
		height: 1px;
		opacity: 0.6;
		background: repeating-linear-gradient(
			90deg, currentColor 0 7px, transparent 7px 14px
		);
	}
	.cut.cyn { color: var(--cy); }
	.cut.red { color: var(--blind); }

	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1rem;
	}
	.lg {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.25rem 0.7rem;
		border: 1px solid var(--edge);
		border-radius: 999px;
		background: var(--panel);
		font-size: 0.72rem;
		color: var(--sl-color-gray-2);
	}
	.sw { flex: none; width: 9px; height: 9px; border-radius: 2px; }
	.sw.k { background: var(--k); }
	.sw.g { background: var(--live); }
	.sw.r { background: var(--blind); }
	.sw.n { background: var(--sl-color-gray-4); }

	@media (max-width: 50rem) {
		.rig { grid-template-columns: minmax(0, 1fr); }
		.bar { flex-wrap: wrap; }
		.bar .sub { margin-left: 2.5rem; text-align: left; width: 100%; }
		.cal { margin: -0.1rem 0 0.6rem 0.9rem; }
		.cal:empty { display: none; }
	}
</style>
