---
// Capacity against bandwidth, from the register file down to host memory.
//
// Drawn as a pyramid because the two quantities move in opposite directions
// and the reader needs both at once: the fastest storage is the smallest, and
// each step down buys roughly an order of magnitude of capacity for roughly an
// order of magnitude of bandwidth. Figures are for a single H100 SXM and are
// approximate. The figure carries the shape; the numbers move per part.

const LEVELS = [
	{
		name: 'Register file',
		width: 22,
		cap: '~256 KB per SM',
		bw: 'tens of TB/s',
		lat: '~1 cycle',
	},
	{
		name: 'Shared memory and L1',
		width: 38,
		cap: '256 KB per SM, split',
		bw: 'several TB/s aggregate',
		lat: '~30 cycles',
	},
	{
		name: 'L2 cache',
		width: 58,
		cap: '50 MB, device-wide',
		bw: 'several TB/s',
		lat: '~200 cycles',
	},
	{
		name: 'Device memory, HBM',
		width: 80,
		cap: '80 GB',
		bw: '~3 TB/s',
		lat: '~400 to 600 cycles',
	},
	{
		name: 'Host memory over NVLink or PCIe',
		width: 100,
		cap: 'System DRAM',
		bw: '~64 GB/s on PCIe 5.0 x16',
		lat: 'microseconds',
	},
];
---

<div class="pyr" role="group" aria-label="Memory hierarchy by capacity and bandwidth">
	{
		LEVELS.map((l, i) => (
			<div class="lvl">
				<div class={`bar t${i}`} style={`width:${l.width}%`}>
					<span class="nm">{l.name}</span>
				</div>
				<div class="meta">
					<span class="cap">{l.cap}</span>
					<span class="bw">{l.bw}</span>
					<span class="lat">{l.lat}</span>
				</div>
			</div>
		))
	}
	<p class="axis">
		widening downward: capacity. Bandwidth and latency move the other way.
	</p>
</div>

<style>
	.pyr {
		--edge: var(--sl-color-gray-5);
		--panel: var(--sl-color-gray-6);
		margin-block: 1.5rem;
	}

	.lvl {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		margin-bottom: 0.35rem;
	}

	.bar {
		display: flex;
		align-items: center;
		flex: none;
		min-width: 8rem;
		padding: 0.5rem 0.8rem;
		border: 1px solid var(--edge);
		border-radius: 0.4rem;
		background: var(--panel);
	}
	.bar.t0 { border-inline-start: 3px solid var(--gs-hue-green); }
	.bar.t1 { border-inline-start: 3px solid var(--gs-hue-green); }
	.bar.t2 { border-inline-start: 3px solid var(--gs-hue-cyan); }
	.bar.t3 { border-inline-start: 3px solid var(--gs-hue-amber); }
	.bar.t4 { border-inline-start: 3px solid var(--gs-hue-red); }

	.nm {
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--sl-color-white);
		line-height: 1.3;
	}

	.meta {
		display: flex;
		flex-direction: column;
		font-family: var(--sl-font-mono);
		font-size: 0.64rem;
		color: var(--sl-color-gray-3);
		line-height: 1.5;
		min-width: 0;
	}
	.meta .cap { color: var(--sl-color-gray-1); }

	.axis {
		margin: 0.7rem 0 0;
		font-family: var(--sl-font-mono);
		font-size: 0.63rem;
		color: var(--sl-color-gray-3);
	}

	@media (max-width: 45rem) {
		.lvl { flex-direction: column; align-items: stretch; gap: 0.2rem; }
		.bar { width: 100% !important; min-width: 0; }
		.meta { flex-direction: row; flex-wrap: wrap; gap: 0.2rem 0.8rem; }
	}
</style>
