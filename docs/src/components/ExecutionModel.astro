---
// The software hierarchy beside the hardware it lands on, with the four
// correspondences drawn across.
//
// Both halves are commonly memorised separately and the mapping between them
// explains the behaviour: a block cannot span an SM, so a block
// too large for one SM's registers never launches. Two lists cannot show that.
// The rows are aligned so each correspondence is one horizontal read.

const ROWS = [
	{
		sw: 'Grid',
		swSub: 'the whole launch',
		hw: 'Device',
		hwSub: 'one GPU',
		rel: 'a launch targets one device',
	},
	{
		sw: 'Thread block',
		swSub: 'up to 1024 threads',
		hw: 'SM',
		hwSub: 'streaming multiprocessor',
		rel: 'a block runs entirely on one SM',
	},
	{
		sw: 'Warp',
		swSub: '32 threads, fixed',
		hw: 'Warp scheduler',
		hwSub: 'several per SM',
		rel: 'one instruction issued for all 32',
	},
	{
		sw: 'Thread',
		swSub: 'own registers and program counter',
		hw: 'Lane',
		hwSub: 'one slot in the warp',
		rel: 'one thread occupies one lane',
	},
];
---

<div class="xm" role="group" aria-label="Software hierarchy mapped onto hardware">
	<div class="hd sw">Software</div>
	<div class="hd rel"></div>
	<div class="hd hw">Hardware</div>

	{
		ROWS.map((r, i) => (
			<>
				<div class={`box sw d${i}`}>
					<span class="nm">{r.sw}</span>
					<span class="sub">{r.swSub}</span>
				</div>
				<div class="rel">
					<span class="line" />
					<span class="txt">{r.rel}</span>
					<span class="line" />
				</div>
				<div class={`box hw d${i}`}>
					<span class="nm">{r.hw}</span>
					<span class="sub">{r.hwSub}</span>
				</div>
			</>
		))
	}
</div>

<style>
	.xm {
		--edge: var(--sl-color-gray-5);
		--panel: var(--sl-color-gray-6);
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(7rem, 13rem) minmax(0, 1fr);
		gap: 0.4rem 0.6rem;
		align-items: stretch;
		margin-block: 1.5rem;
	}

	.hd {
		font-family: var(--sl-font-mono);
		font-size: 0.64rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
		padding-bottom: 0.1rem;
	}
	.hd.hw { text-align: right; }

	.box {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 0.55rem 0.85rem;
		border: 1px solid var(--edge);
		border-radius: 0.5rem;
		background: var(--panel);
	}
	.box.hw { text-align: right; }
	/* Indent each level so the nesting is visible without drawing boxes
	   inside boxes, which collapses at narrow widths. */
	.box.sw.d1 { margin-inline-start: 0.9rem; }
	.box.sw.d2 { margin-inline-start: 1.8rem; }
	.box.sw.d3 { margin-inline-start: 2.7rem; }
	.box.hw.d1 { margin-inline-end: 0.9rem; }
	.box.hw.d2 { margin-inline-end: 1.8rem; }
	.box.hw.d3 { margin-inline-end: 2.7rem; }

	.box.sw { border-inline-start: 3px solid var(--gs-hue-cyan); }
	.box.hw { border-inline-end: 3px solid var(--gs-hue-amber); }

	.nm {
		font-size: 0.88rem;
		font-weight: 620;
		color: var(--sl-color-white);
		line-height: 1.3;
	}
	.sub {
		font-family: var(--sl-font-mono);
		font-size: 0.64rem;
		color: var(--sl-color-gray-3);
	}

	.rel {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.rel .line {
		flex: 1;
		height: 1px;
		background: var(--sl-color-gray-4);
		opacity: 0.6;
	}
	.rel .txt {
		font-size: 0.66rem;
		color: var(--sl-color-gray-2);
		text-align: center;
		line-height: 1.3;
		flex: none;
		max-width: 9rem;
	}

	@media (max-width: 48rem) {
		.xm { grid-template-columns: minmax(0, 1fr); }
		.hd { display: none; }
		.box.sw, .box.hw { margin: 0; text-align: left; }
		.box.hw { border-inline-start: 3px solid var(--gs-hue-amber); border-inline-end: 1px solid var(--edge); }
		.rel { justify-content: flex-start; padding-inline-start: 0.9rem; }
		.rel .line { display: none; }
		.rel .txt { text-align: left; max-width: none; }
	}
</style>
