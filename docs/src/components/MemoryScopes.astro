---
// Address spaces ordered by scope, with bar width standing for how many
// threads can reach each one.
//
// The width is the point. Register through shared through global is usually
// learned as a list of names and latencies, which leaves the reader without
// the one fact that predicts behaviour: how far a value is visible. Local
// memory is drawn narrow and marked as living in device memory, because its
// name suggests the opposite.

const SPACES = [
	{
		name: 'Registers',
		width: 8,
		scope: 'One thread',
		lives: 'On the SM, in the register file',
		latency: '~1 cycle',
		grade: 'fast',
	},
	{
		name: 'Local memory',
		width: 8,
		scope: 'One thread',
		lives: 'In device memory, cached in L1 and L2',
		latency: 'hundreds of cycles',
		grade: 'slow',
	},
	{
		name: 'Shared memory',
		width: 28,
		scope: 'One thread block',
		lives: 'On the SM, sharing capacity with L1',
		latency: 'tens of cycles',
		grade: 'fast',
	},
	{
		name: 'L1 cache',
		width: 28,
		scope: 'One SM',
		lives: 'On the SM',
		latency: 'tens of cycles',
		grade: 'fast',
	},
	{
		name: 'L2 cache',
		width: 60,
		scope: 'Every SM on the device',
		lives: 'On die, beside the memory controllers',
		latency: 'low hundreds of cycles',
		grade: 'mid',
	},
	{
		name: 'Constant memory',
		width: 60,
		scope: 'Every thread, read-only',
		lives: '64 KB window in device memory, with its own cache',
		latency: 'one cycle when the warp reads one address',
		grade: 'mid',
	},
	{
		name: 'Global memory',
		width: 82,
		scope: 'Every thread, and the host',
		lives: 'Device memory: HBM or GDDR',
		latency: 'hundreds of cycles',
		grade: 'slow',
	},
	{
		name: 'Host memory',
		width: 100,
		scope: 'The host, and the device across PCIe',
		lives: 'System DRAM, pageable or pinned',
		latency: 'PCIe or NVLink transfer',
		grade: 'slowest',
	},
];
---

<div class="ms" role="group" aria-label="Address spaces by scope">
	{
		SPACES.map((s) => (
			<div class="row">
				<div class="lab">
					<span class="nm">{s.name}</span>
					<span class="sc">{s.scope}</span>
				</div>
				<div class="track">
					<span class={`bar ${s.grade}`} style={`width:${s.width}%`} />
					<span class="meta">
						<span class="lives">{s.lives}</span>
						<span class="lat">{s.latency}</span>
					</span>
				</div>
			</div>
		))
	}

	<p class="axis">bar width: how many threads can reach the space</p>
</div>

<style>
	.ms {
		--edge: var(--sl-color-gray-5);
		--panel: var(--sl-color-gray-6);
		margin-block: 1.5rem;
	}

	.row {
		display: grid;
		grid-template-columns: minmax(8rem, 11rem) minmax(0, 1fr);
		gap: 0.8rem;
		align-items: center;
		padding: 0.4rem 0;
		border-bottom: 1px solid var(--edge);
	}
	.row:last-of-type { border-bottom: 0; }

	.lab { display: flex; flex-direction: column; }
	.nm {
		font-size: 0.85rem;
		font-weight: 620;
		color: var(--sl-color-white);
		line-height: 1.3;
	}
	.sc {
		font-family: var(--sl-font-mono);
		font-size: 0.63rem;
		color: var(--sl-color-gray-3);
	}

	.track { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }

	.bar {
		display: block;
		height: 0.55rem;
		border-radius: 0.15rem;
		min-width: 1.5rem;
	}
	.bar.fast { background: var(--gs-hue-green); }
	.bar.mid { background: var(--gs-hue-cyan); }
	.bar.slow { background: var(--gs-hue-amber); }
	.bar.slowest { background: var(--gs-hue-red); }

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 0.8rem;
		font-size: 0.7rem;
		color: var(--sl-color-gray-2);
		line-height: 1.4;
	}
	.lat {
		font-family: var(--sl-font-mono);
		font-size: 0.64rem;
		color: var(--sl-color-gray-3);
	}

	.axis {
		margin: 0.7rem 0 0;
		font-family: var(--sl-font-mono);
		font-size: 0.63rem;
		color: var(--sl-color-gray-3);
	}

	@media (max-width: 40rem) {
		.row { grid-template-columns: minmax(0, 1fr); gap: 0.3rem; }
	}
</style>
